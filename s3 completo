  mosi_pin: GPIO11
  miso_pin: GPIO12
  cs_pin: GPIO14
  interrupt_pin: GPIO10
  reset_pin: GPIO9

######################################
### Camera 
######################################

esp32_camera:
  name: ${room_friendly_name} Camera
  external_clock:
    pin: GPIO3
    frequency: 20MHz
  i2c_pins:
    sda: GPIO48
    scl: GPIO47
  data_pins: [GPIO41, GPIO45, GPIO46, GPIO42, GPIO40, GPIO38, GPIO15, GPIO18]
  vsync_pin: GPIO1
  href_pin: GPIO2
  pixel_clock_pin: GPIO39
  power_down_pin: GPIO8
  resolution: 800X600
  jpeg_quality: 10
    #resolution: 1280x1024
    #jpeg_quality: 30
  vertical_flip: false
  horizontal_mirror: false
  # aec_mode: MANUAL
  # aec_value: 1200
  # brightness: 2
  # wb_mode: HOME
  # Tente primeiro o modo automático para Exposure (AEC) e Gain (AGC)
  #aec_mode: AUTO  # Adicione/Descomente
  #agc_mode: AUTO  # Adicione/Descomente

  # Tente remover o modo WB (White Balance) fixo para ver se melhora
  wb_mode: CLOUDY # Comente ou remova
  
  # Outros parâmetros que são geralmente suportados:
  brightness: 0
  contrast: 0
  saturation: 0

#######################################
### Bluetooth Proxy
#######################################

esp32_ble_tracker:
  scan_parameters:
    #  only use these values on Ethernet not WIFI
    interval: 1100ms
    window: 1100ms
    active: true

bluetooth_proxy:
  active: true

switch:
  - platform: gpio
    pin: 
      number: GPIO04
      # inverted: True <--- REMOVA ESTA LINHA COMPLETAMENTE
    name: "Câmera Módulo de Energia"
    id: camera_module_power
