### MPU6050 (I2C separado)
#######################################


globals:
  - id: acc_error_x
    type: float
    restore_value: no
    initial_value: '0.0'
  - id: acc_error_y
    type: float
    restore_value: no
    initial_value: '0.0'
  - id: acc_AngleY
    type: float
    restore_value: no
    initial_value: '0.0'
  - id: acc_AngleX
    type: float
    restore_value: no
    initial_value: '0.0'



script:
  - id: calibrar_mpu
    then:
      - lambda: |-
          float somaX = 0;
          float somaY = 0;
          for (int i = 0; i < 200; i++) {
            if (id(accel_x).has_state() && id(accel_y).has_state() && id(accel_z).has_state()) {
              float ax = id(accel_x).state;
              float ay = id(accel_y).state;
              float az = id(accel_z).state;
              somaX += atan2(-ax, sqrt(ay*ay + az*az)) * 180.0 / 3.1415;
              somaY += atan2(ay, sqrt(ax*ax + az*az)) * 180.0 / 3.1415;
            }
            delay(10);
          }
          id(acc_error_x) = somaX / 200.0;
          id(acc_error_y) = somaY / 200.0;
          ESP_LOGI("calib", "Calibração concluída! ErroX=%.2f ErroY=%.2f", id(acc_error_x), id(acc_error_y));

# ⚡ Executa a calibração logo após o boot (1s depois)
interval:
  - interval: 1s
    then:
      - script.execute: calibrar_mpu

# (Opcional) recalibração periódica
  - interval: 10min
    then:
      - script.execute: calibrar_mpu

sensor:
  - platform: mpu6050
    i2c_id: i2c_mpu   # 🔹 em vez de i2c_pins
    address: 0x68
    update_interval: 200ms
    accel_x:
      name: "MPU6050 Aceleração X"
      id: accel_x
    accel_y:
      name: "MPU6050 Aceleração Y"
      id: accel_y
    accel_z:
      name: "MPU6050 Aceleração Z"
      id: accel_z

  - platform: template
    name: "Pitch Corrigido"
    unit_of_measurement: "°"
    update_interval: 200ms
    lambda: |-
      if (id(accel_x).has_state() && id(accel_y).has_state() && id(accel_z).has_state()) {
        float ax = id(accel_x).state;
        float ay = id(accel_y).state;
        float az = id(accel_z).state;
        float pitch = atan2(ay, sqrt(ax*ax + az*az)) * 180.0 / 3.1415;
        float AccAngleY = id(acc_AngleY) + pitch - id(acc_error_y);
        return AccAngleY;
      } else {
        return NAN;
      }

  - platform: template
    name: "Roll Corrigido"
    unit_of_measurement: "°"
    update_interval: 200ms
    lambda: |-
      if (id(accel_x).has_state() && id(accel_y).has_state() && id(accel_z).has_state()) {
        float ax = id(accel_x).state;
        float ay = id(accel_y).state;
        float az = id(accel_z).state;
        float roll = atan2(-ax, sqrt(ay*ay + az*az)) * 180.0 / 3.1415;
        float AccAngleX = id(acc_AngleX) + roll - id(acc_error_y);
        return AccAngleX;
      } else {
        return NAN;
      }
