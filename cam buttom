esp32_camera:
  i2c_id: bus_a

  external_clock: 
    pin: GPIO0
    frequency: 16MHz
  #reset_pin: GPIO15
  
  data_pins: [GPIO5, GPIO18, GPIO19, GPIO21, GPIO36, GPIO39, GPIO34, GPIO35]
  vsync_pin: GPIO25
  href_pin: GPIO23
  pixel_clock_pin: GPIO22
  #power_down_pin: GPIO32
  #power_down_pin: # <--- REMOVIDO PARA EVITAR CONFLITO COM O SWITCH ACIMA
  
  # Image settings
  name: My Camera
  
  # Parâmetros de Alta Qualidade
  resolution: 800x600
  jpeg_quality: 12
  
  horizontal_mirror: False
  vertical_flip: False

  # NOVOS AJUSTES PARA COR (BALANÇO DE BRANCO) - APENAS PARÂMETROS VÁLIDOS PARA ESP-IDF
  wb_mode: CLOUDY
  
  # Outros parâmetros que são geralmente suportados:
  brightness: 0
  contrast: 0
  saturation: 0
