esphome:
  name: esp32-cam
  friendly_name: esp32-cam

esp32:
  board: esp32dev
  framework:
    type: esp-idf

# Enable logging
logger:

# Enable Home Assistant API
api:
  encryption:
    key: "HbW1woFbQvlM1wuVwNTx9BzSh00PM9bVLaYLjzoHngU="

ota:
  - platform: esphome
    password: "fe797c69e24d1028d7d1100aa3ebb7f6"

# AQUI: Certifique-se de que 'i2c:' está na coluna 1 (sem espaços antes)
i2c:
  id: bus_a
  sda: GPIO26
  scl: GPIO27
  scan: false

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  manual_ip:
    static_ip: 192.168.0.200  # CORRIGIDO para a sua sub-rede
    gateway: 192.168.0.1      # Confirmado pelo ipconfig
    subnet: 255.255.255.0
    
  # Enable fallback hotspot (captive portal) in case wifi connection fails
  ap:
    ssid: "Esp32-Cam Fallback Hotspot"
    password: "TNNiIsEIYkKa"
    
captive_portal:

# Adiciona o servidor web para acesso via navegador
web_server:
  port: 80 # Opcional: define a porta HTTP, 80 é o padrão.

# Adiciona o componente Switch para o LED Flash
switch:
  - platform: gpio
    pin: 
      number: GPIO4 # GPIO4 é o pino do LED Flash na maioria das ESP32-CAMs
      inverted: true # low = ON
    name: "Câmera Luz Flash"
    id: led_flash_camera 

esp32_camera:
  i2c_id: bus_a

  external_clock: 
    pin: GPIO0
    frequency: 20MHz
  
  data_pins: [GPIO5, GPIO18, GPIO19, GPIO21, GPIO36, GPIO39, GPIO34, GPIO35]
  vsync_pin: GPIO25
  href_pin: GPIO23
  pixel_clock_pin: GPIO22
  power_down_pin: GPIO32
  
  # Image settings
  name: My Camera
  
  # Parâmetros de Alta Qualidade
  resolution: 2048x1536
  jpeg_quality: 6 
  
  horizontal_mirror: False
  vertical_flip: False

  # ------------------------------------------------------------------
  # NOVOS AJUSTES PARA COR (BALANÇO DE BRANCO) - APENAS PARÂMETROS VÁLIDOS PARA ESP-IDF
  # ------------------------------------------------------------------
  wb_mode: CLOUDY             # Tente um modo fixo (HOME, SUNNY, CLOUDY, etc.)
  
  # Outros parâmetros que são geralmente suportados:
  brightness: 0
  contrast: 0
  saturation: 0
